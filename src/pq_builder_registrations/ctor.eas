;;; Constructor for the builder PQ material registration request contract.

    ;; Store PRE_FORK in the excess slot. While it is there, requests are queued
    ;; for the fixed fee. The first system call replaces it with a zero excess.
    push (1 << 256) - 2  ; [pre_fork]
    push 0               ; [slot, pre_fork]
    sstore               ; []

    ;; Copy and return the runtime code.
    push len(code)       ; [len]
    dup1                 ; [len, len]
    push @code           ; [codeOffset, len, len]
    push 0               ; [dest, codeOffset, len, len]
    codecopy             ; [len]
    push 0               ; [ptr, len]
    return               ; []

#bytes code: assemble("main.eas")
