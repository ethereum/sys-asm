;;; This is an implementation of EIP-8483's contract handling EL triggered
;;; registrations of post-quantum material for validators.
;;;
;;; A caller (expected to be the execution address in a validator's withdrawal
;;; credentials) submits a 48-byte validator public key, 64 bytes of
;;; post-quantum material and a 2404-byte leanXMSS proof of possession. The
;;; contract charges a fee, checks the proof and queues a record of
;;;
;;;     source_address (20) ++ validator_pubkey (48) ++ pq_data (64)
;;;
;;; and, when called by the system address at the end of a block, dequeues up
;;; to MAX_PER_BLOCK records and returns them concatenated. The consensus layer
;;; checks that source_address controls the validator.
;;;
;;; The first 32 bytes of pq_data are a leanXMSS public key, and the proof is a
;;; signature by that key which binds it to the validator public key. This
;;; contract does not verify the signature itself. It calls the contract at
;;; VERIFIER, which is written in Solidity, and reverts unless that call
;;; returns 1. The proof is neither stored nor logged.
;;;
;;; The queue follows the EIP-7251 consolidation request contract, with one
;;; more storage slot per item. The fee and the system call follow the EIP-8282
;;; builder exit contract (builder_exits/main.eas), with one difference:
;;; requests can be queued before the fork that starts the system call. The
;;; constructor stores PRE_FORK in the excess slot, and while it is there a
;;; request pays the fixed PRE_FORK_FEE. The first system call replaces it with
;;; a zero excess, and from then on requests pay the dynamic fee. As in
;;; EIP-8282, a system call with non-empty calldata disables the queue by
;;; storing INHIBITOR in the excess slot.

#pragma target "prague"

;;; ----------------------------------------------------------------------------
;;; CONSTANTS ------------------------------------------------------------------
;;; ----------------------------------------------------------------------------

#define SYSTEM_ADDR = .address(0xfffffffffffffffffffffffffffffffffffffffe)

#define SLOT_EXCESS = 0
#define SLOT_COUNT = 1

#define QUEUE_HEAD = 2
#define QUEUE_TAIL = 3
#define QUEUE_OFFSET = 4

;;; SLOT_EXCESS holds one of these two values when it isn't an excess. They are
;;; the two largest words, so the system call tells them from an excess with a
;;; single comparison.
#define INHIBITOR = (1 << 256) - 1 ; the queue is disabled, requests revert
#define PRE_FORK = (1 << 256) - 2  ; no system call yet, requests pay PRE_FORK_FEE

#define PRE_FORK_FEE = 500000000000000 ; 0.0005 ETH
#define MIN_FEE = 1
#define TARGET_PER_BLOCK = 128
#define MAX_PER_BLOCK = 1024
#define FEE_UPDATE_FRACTION = 17

#define INPUT_SIZE = 112   ; the size of (pubkey ++ pq_data)
#define RECORD_SIZE = 132  ; the size of (address ++ pubkey ++ pq_data)
#define SLOTS_PER_ITEM = 5 ; (addr, pk[0:32], pk[32:48]++data[0:16], data[16:48], data[48:64])

;;; The proof of possession follows the input in calldata.
#define PROOF_SIZE = 2404  ; the size of a leanXMSS signature
#define REQUEST_SIZE = INPUT_SIZE + PROOF_SIZE ; the size of (pubkey ++ pq_data ++ proof)

;;; The verifier takes the part of the input that the proof signs, which is the
;;; validator public key and the leanXMSS public key, followed by the proof.
;;;
;;; The address is a placeholder. The verifier's address is not chosen yet, and
;;; it has to be set here before this contract is deployed.
#define VERIFIER = .address(0x848300000000000000000000000000000000ffff)
#define SIGNED_SIZE = 80   ; the size of (pubkey ++ pq_data[0:32])
#define VERIFIER_INPUT_SIZE = SIGNED_SIZE + PROOF_SIZE

;;; ----------------------------------------------------------------------------
;;; PROGRAM START --------------------------------------------------------------
;;; ----------------------------------------------------------------------------

    ;; Dispatch to the system subroutine if called by the system address.
    caller                 ; [caller]
    push SYSTEM_ADDR       ; [sysaddr, caller]
    eq                     ; [sysaddr == caller]
    jumpi @read_requests   ; []

;;; ----------------------------------------------------------------------------
;;; USER SUBROUTINE ------------------------------------------------------------
;;; ----------------------------------------------------------------------------

    ;; Load the excess.
    push SLOT_EXCESS       ; [excess_slot]
    sload                  ; [excess]

    ;; Revert while the queue is disabled.
    dup1                   ; [excess, excess]
    push INHIBITOR         ; [inhibitor, excess, excess]
    eq                     ; [inhibitor == excess, excess]
    jumpi @revert          ; [excess]

    ;; Before the first system call, the fee is fixed.
    dup1                   ; [excess, excess]
    push PRE_FORK          ; [pre_fork, excess, excess]
    eq                     ; [pre_fork == excess, excess]
    jumpi @pre_fork_fee    ; [excess]

    ;; Include the requests already added in this block: if the block count
    ;; exceeds TARGET_PER_BLOCK, add the difference to the excess.
    push SLOT_COUNT        ; [count_slot, excess]
    sload                  ; [count, excess]
    push TARGET_PER_BLOCK  ; [target, count, excess]
    dup2                   ; [count, target, count, excess]
    gt                     ; [count > target, count, excess]
    jumpi @bump_excess     ; [count, excess]

    pop                    ; [excess]
    jump @compute_user_fee ; [excess]

bump_excess:               ; [count, excess]
    push TARGET_PER_BLOCK  ; [target, count, excess]
    swap1                  ; [count, target, excess]
    sub                    ; [count-target, excess]
    add                    ; [excess+count-target]

compute_user_fee:          ; [excess]
    ;; Compute the fee using the fake exponential.
    push FEE_UPDATE_FRACTION ; [update_fraction, excess]
    swap1                  ; [excess, update_fraction]
    push MIN_FEE           ; [min_fee, excess, update_fraction]

#include "../common/fake_expo.eas"

    jump @check_input      ; [req_fee]

pre_fork_fee:              ; [excess]
    pop                    ; []
    push PRE_FORK_FEE      ; [req_fee]

check_input:               ; [req_fee]
    ;; If calldatasize matches the expected request size, add the request.
    calldatasize           ; [calldatasize, req_fee]
    push REQUEST_SIZE      ; [REQUEST_SIZE, calldatasize, req_fee]
    eq                     ; [REQUEST_SIZE == calldatasize, req_fee]
    jumpi @handle_input    ; [req_fee]

    ;; Otherwise calldatasize must be zero (fee getter).
    calldatasize           ; [calldatasize, req_fee]
    jumpi @revert          ; [req_fee]

    ;; Reject any value on the read path to prevent lost funds.
    callvalue              ; [value, req_fee]
    jumpi @revert          ; [req_fee]

    ;; Return req_fee.
    push 0                 ; [0, req_fee]
    mstore                 ; []
    push 32                ; [32]
    push 0                 ; [0, 32]
    return                 ; []

handle_input:
    ;; Write path. Request layout:
    ;;
    ;;  +--------+---------+-------+
    ;;  | pubkey | pq_data | proof |
    ;;  +--------+---------+-------+
    ;;      48        64      2404

    ;; Check that the value covers the fee.
    callvalue              ; [callvalue, req_fee]
    lt                     ; [callvalue < req_fee]
    jumpi @revert          ; []

    ;; Check the proof of possession before anything is written. The verifier's
    ;; input is the request without pq_data[32:64], which the proof does not
    ;; sign:
    ;;
    ;;  +--------+---------------+-------+
    ;;  | pubkey | pq_data[0:32] | proof |
    ;;  +--------+---------------+-------+
    ;;      48          32          2404
    push SIGNED_SIZE       ; [size]
    push 0                 ; [ost, size]
    push 0                 ; [dest, ost, size]
    calldatacopy           ; []
    push PROOF_SIZE        ; [size]
    push INPUT_SIZE        ; [ost, size]
    push SIGNED_SIZE       ; [dest, ost, size]
    calldatacopy           ; []

    push 32                ; [ret_size]
    push 0                 ; [ret_ost, ret_size]
    push VERIFIER_INPUT_SIZE ; [in_size, ret_ost, ret_size]
    push 0                 ; [in_ost, in_size, ret_ost, ret_size]
    push VERIFIER          ; [verifier, in_ost, in_size, ret_ost, ret_size]
    gas                    ; [gas, verifier, in_ost, in_size, ret_ost, ret_size]
    staticcall             ; [success]
    iszero                 ; [!success]
    jumpi @revert          ; []

    ;; The proof is valid only if the verifier returned the 32-byte word 1. The
    ;; size is checked because a call to an address without code succeeds and
    ;; returns nothing, which leaves the start of the public key at memory 0.
    returndatasize         ; [returndatasize]
    push 32                ; [32, returndatasize]
    eq                     ; [32 == returndatasize]
    iszero                 ; [32 != returndatasize]
    jumpi @revert          ; []
    push 0                 ; [0]
    mload                  ; [result]
    push 1                 ; [1, result]
    eq                     ; [1 == result]
    iszero                 ; [1 != result]
    jumpi @revert          ; []

    ;; The request pays the fee and its proof is valid, so increment the
    ;; request count.
    push SLOT_COUNT        ; [count_slot]
    sload                  ; [count]
    push 1                 ; [1, count]
    add                    ; [count+1]
    push SLOT_COUNT        ; [count_slot, count+1]
    sstore                 ; []

    ;; Compute the base storage slot of the new queue item.
    push QUEUE_TAIL        ; [tail_idx_slot]
    sload                  ; [tail_idx]
    dup1                   ; [tail_idx, tail_idx]
    push SLOTS_PER_ITEM    ; [slots, tail_idx, tail_idx]
    mul                    ; [slots*tail_idx, tail_idx]
    push QUEUE_OFFSET
    add                    ; [slot, tail_idx]

    ;; Slot 0: source address.
    caller                 ; [caller, slot, ..]
    dup2                   ; [slot, caller, slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 1: pubkey[0:32].
    push 0                 ; [0, slot, ..]
    calldataload           ; [pubkey[0:32], slot, ..]
    dup2                   ; [slot, pubkey[0:32], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 2: pubkey[32:48] ++ pq_data[0:16].
    push 32                ; [32, slot, ..]
    calldataload           ; [pubkey[32:48] ++ pq_data[0:16], slot, ..]
    dup2                   ; [slot, pubkey[32:48] ++ pq_data[0:16], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 3: pq_data[16:48].
    push 64                ; [64, slot, ..]
    calldataload           ; [pq_data[16:48], slot, ..]
    dup2                   ; [slot, pq_data[16:48], slot, ..]
    sstore                 ; [slot, ..]
    push 1                 ; [1, slot, ..]
    add                    ; [slot, ..]

    ;; Slot 4: pq_data[48:64] ++ 16 zero bytes. The proof follows pq_data in
    ;; calldata, so its first 16 bytes are shifted out.
    push 96                ; [96, slot, ..]
    calldataload           ; [pq_data[48:64] ++ proof[0:16], slot, ..]
    push 128               ; [128, pq_data[48:64] ++ proof[0:16], slot, ..]
    shr                    ; [pq_data[48:64], slot, ..]
    push 128               ; [128, pq_data[48:64], slot, ..]
    shl                    ; [pq_data[48:64] ++ 0x00..00, slot, ..]
    swap1                  ; [slot, pq_data[48:64] ++ 0x00..00, ..]
    sstore                 ; [..]

    ;; Assemble the log record: caller ++ input. This overwrites the start
    ;; of the verifier's input in memory, which is no longer needed.
    caller                 ; [caller, ..]
    push 96                ; [96, caller, ..]
    shl                    ; [caller<<96, ..]
    push 0                 ; [0, caller<<96, ..]
    mstore                 ; [..]
    push INPUT_SIZE        ; [size, ..]
    push 0                 ; [ost, size, ..]
    push 20                ; [dest, ost, size, ..]
    calldatacopy           ; [..]

    ;; Log the record.
    push RECORD_SIZE       ; [size, ..]
    push 0                 ; [idx, size, ..]
    log0                   ; [..]

    ;; Advance the queue tail.
    push 1                 ; [1, tail_idx]
    add                    ; [tail_idx+1]
    push QUEUE_TAIL        ; [tail_idx_slot, tail_idx+1]
    sstore                 ; []

    stop

;;; ----------------------------------------------------------------------------
;;; SYSTEM SUBROUTINE ----------------------------------------------------------
;;; ----------------------------------------------------------------------------
;;;
;;; Dequeue up to MAX_PER_BLOCK records and return them as a contiguous byte
;;; array of RECORD_SIZE byte records:
;;;
;;;  +------+--------+---------+
;;;  | addr | pubkey | pq_data |
;;;  +------+--------+---------+
;;;     20      48        64
;;;
;;; Then update the excess and reset the request count.

read_requests:
    ;; count = tail - head
    push QUEUE_TAIL        ; [tail_idx_slot]
    sload                  ; [tail_idx]
    push QUEUE_HEAD        ; [head_idx_slot, tail_idx]
    sload                  ; [head_idx, tail_idx]
    dup1                   ; [head_idx, head_idx, tail_idx]
    dup3                   ; [tail_idx, head_idx, head_idx, tail_idx]
    sub                    ; [count, head_idx, tail_idx]

    ;; count = min(count, MAX_PER_BLOCK)
    dup1                   ; [count, count, head_idx, tail_idx]
    push MAX_PER_BLOCK     ; [max, count, count, head_idx, tail_idx]
    gt                     ; [max > count, count, head_idx, tail_idx]
    jumpi @begin_loop      ; [count, head_idx, tail_idx]
    pop                    ; [head_idx, tail_idx]
    push MAX_PER_BLOCK     ; [count, head_idx, tail_idx]

begin_loop:
    push 0                 ; [i, count, head_idx, tail_idx]

accum_loop:
    ;; Exit when i == count.
    dup2                   ; [count, i, count, head_idx, tail_idx]
    dup2                   ; [i, count, i, count, head_idx, tail_idx]
    eq                     ; [i == count, i, count, head_idx, tail_idx]
    jumpi @update_head     ; [i, count, head_idx, tail_idx]

    ;; slotbase = QUEUE_OFFSET + (head_idx + i) * SLOTS_PER_ITEM
    dup3                   ; [head_idx, i, ..]
    dup2                   ; [i, head_idx, i, ..]
    add                    ; [i+head_idx, i, ..]
    push SLOTS_PER_ITEM    ; [5, i+head_idx, i, ..]
    mul                    ; [5*(i+head_idx), i, ..]
    push QUEUE_OFFSET      ; [offset, 5*(i+head_idx), i, ..]
    add                    ; [slotbase, i, ..]

    ;; offset = i * RECORD_SIZE
    dup2                   ; [i, slotbase, i, ..]
    push RECORD_SIZE       ; [size, i, slotbase, i, ..]
    mul                    ; [offset, slotbase, i, ..]

    ;; mem[offset:offset+20] = addr
    dup2                   ; [slotbase, offset, slotbase, ..]
    sload                  ; [addr, offset, slotbase, ..]
    push 96                ; [96, addr, offset, slotbase, ..]
    shl                    ; [addr<<96, offset, slotbase, ..]
    dup2                   ; [offset, addr<<96, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 20                ; [20, offset, slotbase, ..]
    add                    ; [offset+20, slotbase, ..]

    ;; mem[offset+20:offset+52] = pubkey[0:32]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 1                 ; [1, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [pk1, offset, slotbase, ..]
    dup2                   ; [offset, pk1, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+52:offset+84] = pubkey[32:48] ++ pq_data[0:16]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 2                 ; [2, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [pk2_d1, offset, slotbase, ..]
    dup2                   ; [offset, pk2_d1, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+84:offset+116] = pq_data[16:48]
    dup2                   ; [slotbase, offset, slotbase, ..]
    push 3                 ; [3, slotbase, offset, slotbase, ..]
    add                    ; [slot, offset, slotbase, ..]
    sload                  ; [d2, offset, slotbase, ..]
    dup2                   ; [offset, d2, offset, slotbase, ..]
    mstore                 ; [offset, slotbase, ..]
    push 32                ; [32, offset, slotbase, ..]
    add                    ; [offset+32, slotbase, ..]

    ;; mem[offset+116:offset+132] = pq_data[48:64]. The 16 trailing zero bytes
    ;; spill into the next record, which overwrites them, or past the returned
    ;; range.
    swap1                  ; [slotbase, offset, ..]
    push 4                 ; [4, slotbase, offset, ..]
    add                    ; [slot, offset, ..]
    sload                  ; [d3, offset, ..]
    swap1                  ; [offset, d3, ..]
    mstore                 ; [i, count, head_idx, tail_idx]

    ;; i += 1
    push 1                 ; [1, i, ..]
    add                    ; [i+1, ..]
    jump @accum_loop       ; [i, count, head_idx, tail_idx]

update_head:               ; [i, count, head_idx, tail_idx]
    swap2                  ; [head_idx, count, i, tail_idx]
    add                    ; [new_head_idx, count, tail_idx]

    ;; If the queue is now empty, reset head and tail.
    dup1                   ; [new_head_idx, new_head_idx, count, tail_idx]
    swap3                  ; [tail_idx, new_head_idx, count, new_head_idx]
    eq                     ; [new_head_idx == tail_idx, count, new_head_idx]
    jumpi @reset_queue     ; [count, new_head_idx]

    ;; Otherwise store the new head.
    swap1                  ; [new_head_idx, count]
    push QUEUE_HEAD        ; [head_idx_slot, new_head_idx, count]
    sstore                 ; [count]
    jump @update_excess    ; [count]

reset_queue:
    swap1                  ; [new_head_idx, count]
    pop                    ; [count]
    push 0                 ; [0, count]
    push QUEUE_HEAD        ; [head_slot, 0, count]
    sstore                 ; [count]
    push 0                 ; [0, count]
    push QUEUE_TAIL        ; [tail_slot, 0, count]
    sstore                 ; [count]

update_excess:
    ;; If the system call receives any input, disable the queue by storing
    ;; INHIBITOR into the excess slot.
    calldatasize           ; [calldatasize, count]
    jumpi @set_inhibitor   ; [count]

    ;; Load the current excess and the count of requests added in this block.
    push SLOT_EXCESS       ; [excess_slot, count]
    sload                  ; [excess, count]
    push SLOT_COUNT        ; [count_slot, excess, count]
    sload                  ; [added_count, excess, count]

    ;; If the excess slot holds PRE_FORK or INHIBITOR, start from a zero excess.
    ;; This is the first system call, or the one that re-enables the queue. The
    ;; requests counted before the first system call paid the fixed fee, so
    ;; they don't add to the excess.
    dup2                   ; [excess, added_count, excess, count]
    push PRE_FORK          ; [pre_fork, excess, added_count, excess, count]
    gt                     ; [pre_fork > excess, added_count, excess, count]
    iszero                 ; [excess >= pre_fork, added_count, excess, count]
    jumpi @zero_excess     ; [added_count, excess, count]

    ;; If the sum of the previous excess and the requests added in this block
    ;; is greater than the target, the new excess is that sum minus the target.
    push TARGET_PER_BLOCK  ; [target, added_count, excess, count]
    dup3                   ; [excess, target, added_count, excess, count]
    dup3                   ; [added_count, excess, target, added_count, excess, count]
    add                    ; [added_count+excess, target, added_count, excess, count]
    gt                     ; [added_count+excess > target, added_count, excess, count]
    jumpi @compute_excess  ; [added_count, excess, count]

    ;; Zero out excess.
zero_excess:               ; [added_count, excess, count]
    pop                    ; [excess, count]
    pop                    ; [count]
    push 0                 ; [0, count]
    jump @store_excess     ; [0, count]

compute_excess:            ; [added_count, excess, count]
    add                    ; [added_count+excess, count]
    push TARGET_PER_BLOCK  ; [target, added_count+excess, count]
    swap1                  ; [added_count+excess, target, count]
    sub                    ; [new_excess, count]
    jump @store_excess     ; [new_excess, count]

set_inhibitor:             ; [count]
    push INHIBITOR         ; [new_excess, count]

store_excess:              ; [new_excess, count]
    push SLOT_EXCESS       ; [excess_slot, new_excess, count]
    sstore                 ; [count]

    ;; Reset the request count.
    push 0                 ; [0, count]
    push SLOT_COUNT        ; [count_slot, 0, count]
    sstore                 ; [count]

    ;; Return count * RECORD_SIZE bytes.
    push RECORD_SIZE       ; [record_size, count]
    mul                    ; [size]
    push 0                 ; [0, size]
    return                 ; []

revert:                    ; [...]
    push 0                 ; [size]
    push 0                 ; [offset, size]
    revert                 ; []
